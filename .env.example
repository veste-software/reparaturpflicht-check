# Names only. Never commit values. Copy to .env locally; set them in the host's dashboard for production.

# --- Build / hosting ---
# Absolute origin of the deployed site, e.g. the custom domain. The GitHub Pages workflow sets it automatically.
SITE_URL=
# Base path. "/" on the custom domain; the GitHub Pages workflow sets "/<repo>".
SITE_BASE=

# --- EPREL proxy (Cloudflare Pages Function functions/api/eprel/[id].ts) ---
# Contact string appended to the proxy's User-Agent so EPREL can identify us (e.g. a URL or mailbox name).
EPREL_USER_AGENT_CONTACT=
# Phase 2 only (brand/model search, bulk model pages). Requested by the human at eprel.ec.europa.eu.
EPREL_API_KEY=
# Optional: absolute URL of the proxy, e.g. https://<domain>/api/eprel/ . Empty = same origin <base>api/eprel/.
PUBLIC_EPREL_PROXY_URL=

# --- Cookie-free analytics (Plausible-compatible script). Leave empty to disable analytics completely. ---
PUBLIC_ANALYTICS_DOMAIN=
# e.g. https://plausible.io/js/script.js or a self-hosted Plausible/Umami-compatible script URL
PUBLIC_ANALYTICS_SCRIPT_URL=

# --- Affiliate slots (off when empty). PUBLIC_ because result pages render in the browser. ---
# Spare-parts shop deep link with a {model} placeholder
PUBLIC_AFFILIATE_PARTS_URL_TEMPLATE=
# Refurbished-device partner link
PUBLIC_AFFILIATE_REFURB_URL=

# --- Phase 2 (not used in the MVP): letter by registered mail, Stripe TEST mode only ---
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
