---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import LookupTool from '../components/LookupTool';
---

<Base title="Seite nicht gefunden | Reparaturpflicht-Check" description="Diese Seite gibt es nicht." noindex>
  <h1 class="text-2xl font-bold">Seite nicht gefunden</h1>
  <p class="mt-4">
    Zur Startseite: <a class="underline" href={withBase('')}>Reparaturpflicht-Check</a>
  </p>
  <!-- GitHub Pages serves unknown /qr/<n> paths through this page; the tool reads <n> from the path. -->
  <LookupTool client:load readFromPath />
</Base>
